import os
import cv2
import json
import numpy as np
from skimage import measure
from scipy.spatial import distance
import matplotlib.pyplot as plt
from tqdm import tqdm

from util import load_config, update_config

# ==========================================
# --- CORE MEASUREMENT FUNCTION ---
# ==========================================

def measure_and_label_from_seg(img, seg_file_path, config):
    """
    Measures organoids directly from an existing seg.npy file and an organoid image.
    """
    print(f"-> Loading segmentation file: {seg_file_path}")
    target_shape = (config["resolution"]["height"], config["resolution"]["width"])
    scale_factor = config["scale"]["um"] / config["scale"]["px"]
    
    # 1. Load the segmentation mask array
    data = np.load(seg_file_path, allow_pickle=True)
    if 'outlines' not in data:
        raise ValueError("The .npy file does not contain an 'outlines' key.")
        
    outlines = data['outlines'] # List of (N, 2) outline arrays
    
    # 2. Load the base image to use for dimensions and visualization canvas
    raw_img = cv2.imread(img)
    if raw_img is None:
        raise FileNotFoundError(f"Original image not found at {img}")
        
    resized_img = cv2.resize(raw_img, (target_shape[1], target_shape[0]), 
                             interpolation=cv2.INTER_LANCZOS4)
    
    output_dir = "output_results"
    os.makedirs(output_dir, exist_ok=True)
    
    fig, ax = plt.subplots(figsize=(target_shape[1]/100, target_shape[0]/100), dpi=100)
    ax.imshow(cv2.cvtColor(resized_img, cv2.COLOR_BGR2RGB))
    
    print(f"-> Found {len(outlines)} organoid outlines. Measuring...")
    
    # 3. Process the organoid outlines
    for idx, outline in enumerate(tqdm(outlines, desc="Measuring")):
        if len(outline) < 2: 
            continue
            
        # For an array of (Y, X) coordinates, calculate all pairwise distances
        dist_matrix = distance.pdist(outline)
        max_d_px = np.max(dist_matrix)
        
        # Convert measurement to micrometers
        max_d_real = max_d_px * scale_factor
        
        # Find the center (centroid) of the outline to place the text label
        y_c = np.mean(outline[:, 0])
        x_c = np.mean(outline[:, 1])
        
        ax.text(x_c, y_c, f"{max_d_real:.0f}", color='yellow', 
                fontsize=7, ha='center', weight='bold', 
                bbox=dict(facecolor='black', alpha=0.5, pad=1, edgecolor='none'))

    plt.axis('off')
    output_filepath = os.path.join(output_dir, f"Result_from_outline_measured.jpg")
    plt.savefig(output_filepath, bbox_inches='tight', pad_inches=0)
    plt.close()
    
    print(f"-> Processing complete! Labeled image saved to {output_filepath}")

# ==========================================
# --- RUN ---
# ==========================================
if __name__ == "__main__":
    config = load_config()
    
    # Path to your existing seg.npy file
    # Update this path if the npy file is in a different folder
    IN_FILE = "test.jpg"
    SEG_FILE = os.path.join("test_seg.npy")
    
    if os.path.exists(SEG_FILE):
        measure_and_label_from_seg(IN_FILE, SEG_FILE, config)
    else:
        print(f"Error: Could not find {SEG_FILE}. Please run Cellpose segmentation once first or check the path.")